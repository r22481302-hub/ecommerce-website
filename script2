const products=[
{id:1,name:"Wireless Headphones",category:"electronics",price:2499,icon:"🎧"},{id:2,name:"Smart Watch",category:"electronics",price:1999,icon:"⌚"},
{id:3,name:"Casual Sneakers",category:"fashion",price:1799,icon:"👟"},{id:4,name:"Classic Backpack",category:"fashion",price:1299,icon:"🎒"},
{id:5,name:"Desk Lamp",category:"home",price:899,icon:"💡"},{id:6,name:"Coffee Mug",category:"home",price:499,icon:"☕"},
{id:7,name:"Bluetooth Speaker",category:"electronics",price:1599,icon:"🔊"},{id:8,name:"Hoodie",category:"fashion",price:999,icon:"🧥"}];
let cart=JSON.parse(localStorage.getItem("shopEaseCart")||"[]");
const grid=document.getElementById("productGrid"),filter=document.getElementById("categoryFilter");
function renderProducts(){const v=filter.value;grid.innerHTML=products.filter(p=>v==="all"||p.category===v).map(p=>`<article class="product"><div class="product-img">${p.icon}</div><div class="product-body"><span class="category">${p.category}</span><h3>${p.name}</h3><div class="price">₹${p.price.toLocaleString()}</div><button class="add" onclick="addToCart(${p.id})">Add to Cart</button></div></article>`).join("")}
function save(){localStorage.setItem("shopEaseCart",JSON.stringify(cart))}
function addToCart(id){const x=cart.find(a=>a.id===id);x?x.qty++:cart.push({id,qty:1});save();updateCart();alert("Product added to cart!")}
function updateCart(){document.getElementById("cartCount").textContent=cart.reduce((s,x)=>s+x.qty,0);const box=document.getElementById("cartItems");if(!cart.length){box.innerHTML="<p>Your cart is empty.</p>";document.getElementById("total").textContent="0";return}let total=0;box.innerHTML=cart.map(x=>{const p=products.find(a=>a.id===x.id);total+=p.price*x.qty;return `<div class="cart-row"><span>${p.icon}</span><span class="name">${p.name}<br>₹${p.price.toLocaleString()}</span><span class="qty"><button onclick="changeQty(${p.id},-1)">−</button> ${x.qty} <button onclick="changeQty(${p.id},1)">+</button></span></div>`}).join("");document.getElementById("total").textContent=total.toLocaleString()}
function changeQty(id,d){const x=cart.find(a=>a.id===id);if(!x)return;x.qty+=d;if(x.qty<=0)cart=cart.filter(a=>a.id!==id);save();updateCart()}
filter.onchange=renderProducts;document.getElementById("cartBtn").onclick=()=>document.getElementById("cartModal").classList.remove("hidden");document.getElementById("closeCart").onclick=()=>document.getElementById("cartModal").classList.add("hidden");document.getElementById("checkout").onclick=()=>alert("Demo checkout — no real payment is processed.");renderProducts();updateCart();